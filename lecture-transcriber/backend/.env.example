# STT provider: groq (default) or openai
STT_PROVIDER=groq
STT_TIMEOUT_SECONDS=900
STT_MAX_RETRIES=2
STT_CHUNKING_ENABLED=true
STT_CHUNK_SECONDS=240
FFMPEG_BINARY=ffmpeg
STT_LONG_AUDIO_THRESHOLD_BYTES=26214400
PROCESS_DEFAULT_SUMMARY_BULLETS=12
PROCESS_DEFAULT_FLASHCARDS=20
PROCESS_DEFAULT_QUIZZES=10
TRANSCRIPT_CLEANING_ENABLED=true

# Groq (OpenAI-compatible)
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# OpenAI fallback
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_WHISPER_MODEL=whisper-1
OPENAI_LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
